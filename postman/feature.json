        {
          "name": "Private / Попытка оставить комментарий к своему событию",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const main = async () => {",
                  "    const api = new API(pm);",
                  "    const rnd = new RandomUtils();",
                  "",
                  "    try {",
                  "        const owner = await api.addUser(rnd.getUser());",
                  "        const category = await api.addCategory(rnd.getCategory());",
                  "        const event = await api.addEvent(owner.id, rnd.getEvent(category.id));",
                  "        const comment = rnd.getComment();",
                  "",
                  "        pm.collectionVariables.set('commentUserId', owner.id);",
                  "        pm.collectionVariables.set('commentEventId', event.id);",
                  "        pm.collectionVariables.set('request_body', JSON.stringify(comment));",
                  "    } catch (err) {",
                  "        console.error('Ошибка при подготовке тестовых данных.', err);",
                  "    }",
                  "};",
                  "",
                  "const interval = setInterval(() => {}, 1000);",
                  "setTimeout(async () => {",
                  "    try {",
                  "        await main();",
                  "    } catch (e) {",
                  "        console.error(e);",
                  "    } finally {",
                  "        clearInterval(interval);",
                  "    }",
                  "}, 100);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ответ должен содержать код статуса 409 и данные в формате json', function () {",
                  "    pm.response.to.have.status(409);",
                  "    pm.response.to.be.withBody;",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "const target = pm.response.json();",
                  "pm.test('Ошибка должна содержать стандартные поля', function () {",
                  "    pm.expect(target).to.include.all.keys('status', 'reason', 'message', 'timestamp');",
                  "});"
                ]
              }
            }
          ],
